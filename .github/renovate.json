{
  "extends": [
    "github>rancher/renovate-config#release"
  ],
  "baseBranchPatterns": [
    "main",
    "release/v2.11",
    "release/v2.12",
    "release/v2.13",
    "release/v2.14",
    "release/v2.15",
    "release/v2.16"
  ],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "reviewers": [
    "HarrisonWAffel"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^build\\.json$/"
      ],
      "matchStrings": [
        "\"repo\":\\s*\"(?<depName>[^\"]+)\",\\s*\"tag\":\\s*\"(?<currentValue>[^\"]+)\",\\s*\"sha\":\\s*\"(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Disable auto-merge except for severe security updates",
      "matchJsonata": [
        "true"
      ],
      "automerge": false
    },
    {
      "description": "Automerge eligible security updates",
      "matchDepTypes": [
        "!devDependencies",
        "!dev-dependencies",
        "!test"
      ],
      "matchJsonata": [
        "($exists(vulnerabilityFixVersion) or $exists(isVulnerabilityAlert)) and (vulnerabilitySeverity = 'HIGH' or vulnerabilitySeverity = 'CRITICAL')"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true
    },
    {
      "matchBaseBranches": [
        "main"
      ],
      "extends": [
        "github>rancher/renovate-config//rancher-main#main"
      ]
    },
    {
      "matchBaseBranches": [
        "release/v2.11"
      ],
      "extends": [
        "github>rancher/renovate-config//rancher-2.11#release"
      ]
    },
    {
      "matchBaseBranches": [
        "release/v2.12"
      ],
      "extends": [
        "github>rancher/renovate-config//rancher-2.12#release"
      ]
    },
    {
      "matchBaseBranches": [
        "release/v2.13"
      ],
      "extends": [
        "github>rancher/renovate-config//rancher-2.13#release"
      ]
    },
    {
      "matchBaseBranches": [
        "release/v2.14"
      ],
      "extends": [
        "github>rancher/renovate-config//rancher-2.14#release"
      ]
    },
    {
      "matchBaseBranches": [
        "release/v2.15"
      ],
      "extends": [
        "github>rancher/renovate-config//rancher-2.15#release"
      ]
    },
    {
      "matchBaseBranches": [
        "release/v2.16"
      ],
      "extends": [
        "github>rancher/renovate-config//rancher-2.16#release"
      ]
    }
  ]
}
