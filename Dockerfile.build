ARG GO_VERSION=1.26

FROM registry.rancher.com/rancher/appco-go:${GO_VERSION} AS build
ARG TAG
ENV TAG=${TAG} \
    GOTOOLCHAIN=local \
    CGO_ENABLED=0
WORKDIR /src

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/root/go/pkg/mod go mod download

RUN --mount=type=cache,target=/root/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    GOBIN=/usr/local/bin go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@c0d3ddc9cf3faa61a4e378e879ece580256d76e5

COPY . .
RUN --mount=type=cache,target=/root/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go run github.com/magefile/mage -d magefiles buildAll

FROM scratch AS artifacts
COPY --from=build /src/artifacts/ /artifacts/
COPY --from=build /src/bin/ /bin/
COPY --from=build /src/tests/integration/bin/test_service.exe /tests/integration/bin/test_service.exe
COPY --from=build /src/suc/pkg/host/wins.exe /suc/pkg/host/wins.exe
COPY --from=build /src/LICENSE /LICENSE
