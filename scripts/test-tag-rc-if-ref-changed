#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
tagger="$repo_root/scripts/tag-rc-if-ref-changed"
tmpdir="$(mktemp -d)"
source_repo="$tmpdir/source"
runner_repo="$tmpdir/runner"

trap 'rm -rf "$tmpdir"' EXIT

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

setup_repo() {
  local tag="$1"

  rm -rf "$source_repo" "$runner_repo"
  git init --quiet -b main "$source_repo"
  git -C "$source_repo" config user.name tester
  git -C "$source_repo" config user.email tester@example.com
  git -C "$source_repo" config commit.gpgSign false
  printf 'initial\n' > "$source_repo/README"
  git -C "$source_repo" add README
  git -C "$source_repo" commit --quiet -m initial
  git -C "$source_repo" tag --no-sign -a "$tag" -m "$tag"

  git clone --quiet "$source_repo" "$runner_repo"
  git -C "$runner_repo" config user.name tester
  git -C "$runner_repo" config user.email tester@example.com
}

commit_to_branch() {
  local message="$1"
  printf '%s\n' "$message" >> "$source_repo/README"
  git -C "$source_repo" commit --quiet -am "$message"
}

run_tagger() {
  (cd "$runner_repo" && "$tagger" "${1:-v0\.17\.}" "${2:-origin}" "${3:-main}")
}

assert_tag_points_to_ref() {
  local tag="$1"
  local tag_commit
  local ref_commit
  tag_commit="$(git -C "$runner_repo" rev-parse "${tag}^{commit}")"
  ref_commit="$(git -C "$source_repo" rev-parse main)"
  test "$tag_commit" = "$ref_commit" || fail "$tag does not point to main"
}

setup_repo v0.17.0
run_tagger
test -z "$(git -C "$source_repo" tag --list 'v0.17.1-rc.*')" ||
  fail "created a tag for an unchanged ref"

commit_to_branch first-change
run_tagger
test "$(git -C "$runner_repo" tag --list 'v0.17.1-rc.0')" = v0.17.1-rc.0 ||
  fail "missing initial RC tag"
assert_tag_points_to_ref v0.17.1-rc.0

commit_to_branch second-change
run_tagger
test "$(git -C "$runner_repo" tag --list 'v0.17.1-rc.1')" = v0.17.1-rc.1 ||
  fail "missing incremented RC tag"
assert_tag_points_to_ref v0.17.1-rc.1

run_tagger
test "$(git -C "$runner_repo" tag --list 'v0.17.1-rc.*' | wc -l)" -eq 2 ||
  fail "created a duplicate tag"

setup_repo v0.16.2-rc.1
commit_to_branch release-change
run_tagger 'v0\.16\.'
test "$(git -C "$runner_repo" tag --list 'v0.16.2-rc.2')" = v0.16.2-rc.2 ||
  fail "failed to increment an existing RC series"

setup_repo v0.16.0.1
if run_tagger 'v0\.16\.' >"$tmpdir/invalid-output" 2>&1; then
  fail "accepted an unsupported RC tag format"
fi
grep -q 'none match the supported format' "$tmpdir/invalid-output" ||
  fail "did not report missing supported tags"

echo "tag-rc-if-ref-changed tests passed"
